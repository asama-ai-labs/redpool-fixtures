redfish_network_port_state_info{adapter_id="NIC.Embedded.1",chassis_id="System.Embedded.1",current_link_speed_mbps="0",id="NIC.Embedded.2-1",link_status="LinkDown",state="Enabled"} 1
redfish_network_port_state_info{adapter_id="NIC.Embedded.1",chassis_id="System.Embedded.1",current_link_speed_mbps="1000",id="NIC.Embedded.1-1",link_status="LinkUp",state="Enabled"} 1
redfish_network_port_state_info{adapter_id="NIC.Integrated.1",chassis_id="System.Embedded.1",current_link_speed_mbps="0",id="NIC.Integrated.1-1",link_status="LinkDown",state="Enabled"} 1
redfish_network_port_state_info{adapter_id="NIC.Integrated.1",chassis_id="System.Embedded.1",current_link_speed_mbps="0",id="NIC.Integrated.1-2",link_status="LinkDown",state="Enabled"} 1
# HELP redfish_network_state_info Gauge 1 with Redfish state as a label. Redfish Resource.State on the state label. Enum: Enabled, Disabled, StandbyOffline, StandbySpare, InTest, Starting, Absent, UnavailableOffline, Deferring, Quiesced, Updating, Qualified. Unknown when omitted.
# TYPE redfish_network_state_info gauge
redfish_network_state_info{id="NIC.Embedded.1-1-1",state="Enabled"} 1
redfish_network_state_info{id="NIC.Embedded.2-1-1",state="Enabled"} 1
redfish_network_state_info{id="NIC.Integrated.1-1-1",state="Enabled"} 1
redfish_network_state_info{id="NIC.Integrated.1-2-1",state="Enabled"} 1
