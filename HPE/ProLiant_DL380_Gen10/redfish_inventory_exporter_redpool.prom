# HELP redfish_bmc_manager_health_info Gauge 1 with Redfish health as a label. Redfish Resource.Health on the health label. Enum: OK, Warning, Critical. The exporter uses Unknown when the BMC omits health.
# TYPE redfish_bmc_manager_health_info gauge
redfish_bmc_manager_health_info{health="OK",id="1"} 1
# HELP redfish_bmc_manager_info BMC Manager resource (constant 1) with id, name, model, manufacturer, firmware_version, uuid labels (uuid is Manager.UUID; empty when omitted).
# TYPE redfish_bmc_manager_info gauge
redfish_bmc_manager_info{firmware_version="iLO 5 v3.08",id="1",manufacturer="HPE",model="iLO 5",name="Manager",uuid="550e8400-e29b-41d4-a716-000000000004"} 1
# HELP redfish_bmc_manager_state_info Gauge 1 with Redfish state as a label. Redfish Resource.State on the state label. Enum: Enabled, Disabled, StandbyOffline, StandbySpare, InTest, Starting, Absent, UnavailableOffline, Deferring, Quiesced, Updating, Qualified. Unknown when omitted.
# TYPE redfish_bmc_manager_state_info gauge
redfish_bmc_manager_state_info{id="1",state="Enabled"} 1
# HELP redfish_chassis_health_info Gauge 1 with Redfish health as a label. Redfish Resource.Health on the health label. Enum: OK, Warning, Critical. The exporter uses Unknown when the BMC omits health.
# TYPE redfish_chassis_health_info gauge
redfish_chassis_health_info{health="OK",health_rollup="Unknown",id="1"} 1
# HELP redfish_chassis_info Chassis resource (constant 1) with id, model, sku, manufacturer, device_serial_number, asset_tag, chassis_type, contained_by, and FRU/engineering_change_level from Assembly when present.
# TYPE redfish_chassis_info gauge
redfish_chassis_info{asset_tag="",chassis_type="RackMount",contained_by="",contains="",device_serial_number="DUMMY-SerialNumber-1",engineering_change_level="",fru_part_number="",id="1",manufacture_date="",manufacturer="HPE",model="ProLiant DL380 Gen10",part_number="",sku="DUMMY-SKU-1"} 1
# HELP redfish_chassis_power_state_info Redfish Chassis.PowerState on power_state. Enum: On, Off, PausedSleeping, PoweringOn, PoweringOff. Unknown when omitted.
# TYPE redfish_chassis_power_state_info gauge
redfish_chassis_power_state_info{id="1",power_state="On"} 1
# HELP redfish_chassis_state_info Gauge 1 with Redfish state as a label. Redfish Resource.State on the state label. Enum: Enabled, Disabled, StandbyOffline, StandbySpare, InTest, Starting, Absent, UnavailableOffline, Deferring, Quiesced, Updating, Qualified. Unknown when omitted.
# TYPE redfish_chassis_state_info gauge
redfish_chassis_state_info{id="1",state="Enabled"} 1
