# HELP redfish_thermal_summary_health_info Gauge 1 with Redfish health as a label. Redfish Resource.Health on the health label. Enum: OK, Warning, Critical. The exporter uses Unknown when the BMC omits health.
# TYPE redfish_thermal_summary_health_info gauge
redfish_thermal_summary_health_info{chassis_id="1",health="Unknown"} 1
# HELP redfish_thermal_summary_info Thermal subsystem summary (constant 1) for the chassis thermal resource URL.
# TYPE redfish_thermal_summary_info gauge
redfish_thermal_summary_info{chassis_id="1",url="/redfish/v1/Chassis/1/Thermal"} 1
# HELP redfish_thermal_summary_state_info Gauge 1 with Redfish state as a label. Redfish Resource.State on the state label. Enum: Enabled, Disabled, StandbyOffline, StandbySpare, InTest, Starting, Absent, UnavailableOffline, Deferring, Quiesced, Updating, Qualified. Unknown when omitted.
# TYPE redfish_thermal_summary_state_info gauge
redfish_thermal_summary_state_info{chassis_id="1",state="Unknown"} 1